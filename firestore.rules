rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { allow read, write: if false; }
    
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      return isSignedIn() && (
        ('email' in request.auth.token && request.auth.token.email != null && (
          request.auth.token.email.lower() == 'freshnlocalco@gmail.com' || 
          request.auth.token.email.lower() == 'mohitswami855@gmail.com' || 
          request.auth.token.email.lower() == 'freshnlocal2@gmail.com' || 
          request.auth.token.email.lower() == 'system-email-trigger@freshnlocal.com'
        )) || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'customer') == 'admin')
      ); 
    }
    
    match /users/{userId} {
      match /recipeChat/{chatId} {
        function isValidRecipeChat(data) {
          return data.size() >= 2 && data.size() <= 10
            && data.keys().hasAll(['messages', 'updatedAt'])
            && data.messages is list
            && data.updatedAt is number;
        }
        allow read, list: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        allow create, update: if isSignedIn() && request.auth.uid == userId && isValidRecipeChat(incoming());
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
      match /savedRecipes/{recipeId} {
        function isValidSavedRecipe(data) {
          return data.size() >= 2 && data.size() <= 10
            && data.keys().hasAll(['recipeMarkdown', 'createdAt'])
            && data.recipeMarkdown is string && data.recipeMarkdown.size() <= 50000
            && data.createdAt is number;
        }
        allow read, list: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        allow create: if isSignedIn() && request.auth.uid == userId && isValidSavedRecipe(incoming());
        allow update: if isSignedIn() && request.auth.uid == userId && isValidSavedRecipe(incoming()) && incoming().createdAt == existing().createdAt;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
      function isValidUser(data) {
        return data.size() >= 3 && data.size() <= 30
          && data.keys().hasAll(['email', 'role', 'createdAt'])
          && data.email is string && data.email.size() <= 150
          && data.role is string && (data.role == 'customer' || data.role == 'admin' || data.role == 'horeca')
          && data.createdAt is number;
      }
      
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      
      allow create: if isSignedIn() 
        && request.auth.uid == userId 
        && isValidUser(incoming())
        && (incoming().role == 'customer' || incoming().role == 'horeca' || (incoming().role == 'admin' && request.auth.token.email != null && (request.auth.token.email.lower() == 'freshnlocalco@gmail.com' || request.auth.token.email.lower() == 'mohitswami855@gmail.com' || request.auth.token.email.lower() == 'freshnlocal2@gmail.com')) || isAdmin());
        
      allow update: if isSignedIn() 
        && (request.auth.uid == userId || isAdmin())
        && isValidUser(incoming())
        && (incoming().role == existing().role || (incoming().role == 'admin' && request.auth.token.email != null && (request.auth.token.email.lower() == 'freshnlocalco@gmail.com' || request.auth.token.email.lower() == 'mohitswami855@gmail.com' || request.auth.token.email.lower() == 'freshnlocal2@gmail.com')) || isAdmin());
    }
    
    match /products/{productId} {
      function isValidProduct(data) {
        return data.keys().hasAll(['name', 'price', 'createdAt', 'updatedAt'])
        && data.size() >= 4 && data.size() <= 30
        && data.name is string && data.name.size() <= 200 && data.name.size() > 0
        && data.price is number && data.price >= 0
        && data.createdAt is number
        && data.updatedAt is number;
      }
      
      allow read, list: if true;
      allow create: if isAdmin() && isValidProduct(incoming());
      allow update: if isAdmin() && isValidProduct(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin();
    }
    
    match /orders/{orderId} {
      function isValidOrder(data) {
        return data.keys().hasAll(['userId', 'items', 'totalAmount', 'status', 'paymentMethod', 'createdAt', 'updatedAt'])
        && data.userId is string && data.userId.size() <= 128
        && data.items is list && data.items.size() <= 100 && data.items.size() > 0
        && data.totalAmount is number && data.totalAmount >= 0
        && data.status is string
        && data.paymentMethod is string && data.paymentMethod.size() <= 50
        && data.createdAt is number
        && data.updatedAt is number;
      }
      
      allow read, list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      
      allow create: if isSignedIn()
        && isValidOrder(incoming())
        && incoming().userId == request.auth.uid
        && incoming().status == 'pending';
        
      allow update: if isSignedIn() 
        && isValidOrder(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && (
          (request.auth.uid == existing().userId && (existing().status == 'pending') && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) && incoming().status == 'cancelled') || 
          isAdmin()
        );
        
      allow delete: if isAdmin();
    }
    
    match /settings/{settingId} {
      allow read, list: if true;
      allow create, update, delete: if isAdmin();
    }
    
    match /reviews/{reviewId} {
      function isValidReview(data) {
        return data.size() >= 5 && data.size() <= 12
          && data.keys().hasAll(['productId', 'userId', 'userName', 'rating', 'comment', 'createdAt'])
          && data.productId is string && data.productId.size() <= 128
          && data.userId is string && data.userId.size() <= 128
          && data.userName is string && data.userName.size() <= 100
          && data.rating is number && data.rating >= 1 && data.rating <= 5
          && data.comment is string && data.comment.size() <= 2000
          && data.createdAt is number;
      }
      
      allow read, list: if true;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && isValidReview(incoming());
      allow update: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin()) && isValidReview(incoming());
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
    }
  }
}
